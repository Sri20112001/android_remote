# Backend of the Remote Deck agent, baked into the app at build time.
#
# Copy this file to `.env` and set it to your PC's LAN address — the same
# address the pairing QR encodes. The app prefills it and probes the PC on
# launch, so you do not have to type a URL or scan a QR code every time.
#
# Format: scheme://host:port   (http unless your agent runs TLS)
EXPO_PUBLIC_AGENT_URL=http://192.168.1.10:8765
