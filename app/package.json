  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "backend": "powershell -ExecutionPolicy Bypass -File ../agent/windows/scripts/dev.ps1",
